<PanelContainer xmlns="https://spacestation14.io" MinHeight="32">
    <BoxContainer Orientation="Horizontal" Margin="8 2" SeparationOverride="8">
        <TextureRect Name="JobIcon" SetSize="24 24" Stretch="KeepAspectCentered"
                     VerticalAlignment="Center" />
        <Label Name="JobName" HorizontalExpand="True" ClipText="True" />
        <BoxContainer Orientation="Horizontal" SetWidth="144" SeparationOverride="2">
            <Button Name="DecreaseButton" Text="{Loc admin-station-job-slots-decrease}"
                    ToolTip="{Loc admin-station-job-slots-decrease-tooltip}" />
            <PanelContainer Name="SlotPanel" StyleClasses="PanelDark" HorizontalExpand="True">
                <Label Name="SlotCount" Align="Center" />
            </PanelContainer>
            <Button Name="IncreaseButton" Text="{Loc admin-station-job-slots-increase}"
                    ToolTip="{Loc admin-station-job-slots-increase-tooltip}" />
        </BoxContainer>
        <Control SetWidth="56">
            <Button Name="UnlimitedButton" Text="{Loc admin-station-job-slots-unlimited}" ToggleMode="True" />
            <Label Name="UnlimitedHeading" Text="{Loc admin-station-job-slots-unlimited}"
                   Align="Center" StyleClasses="LabelKeyText" Visible="False" />
        </Control>
    </BoxContainer>
</PanelContainer>
